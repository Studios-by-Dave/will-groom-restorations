---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
---

<Layout
  title="Contact — Will Groom Restorations"
  description="Get in touch with Will Groom Restorations for a free, no-obligation quote on your antique or furniture restoration project."
>
  <Header />

  <main>
    <!-- Page hero -->
    <section class="page-hero section--plum">
      <div class="container">
        <p class="eyebrow">Get in touch</p>
        <h1>Ready to restore your piece? Let’s talk.</h1>
        <p class="lead">
          Tell us about your furniture and we’ll guide you through the
          possibilities — with a free, no-obligation quote.
        </p>
      </div>
    </section>

    <!-- Contact -->
    <section class="section section--paper" id="quote">
      <div class="container contact-grid">
        <!-- Form -->
        <div class="contact-form-wrap reveal">
          <h2>Request a free quote</h2>
          <p class="contact-form-wrap__sub">
            The more detail (and photos) you can share, the better we can help.
          </p>
          <form id="contact-form" class="contact-form" novalidate>
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="phone">Phone <span class="field__opt">(optional)</span></label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>
            <div class="field">
              <label for="message">Project details</label>
              <textarea id="message" name="message" rows="5" required
                placeholder="Tell us about the piece — type of furniture, age if known, what it needs, and any photos you can attach."></textarea>
            </div>
            <button type="submit" class="btn btn--gold btn--lg btn--block">
              Send Message
            </button>
            <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
          </form>
          <p class="form-note">
            Prefer to talk it through? Reach us directly using the details on the
            right.
          </p>
        </div>

        <!-- Info + map -->
        <aside class="contact-info reveal">
          <div class="info-card">
            <h3>Contact details</h3>
            <ul>
              <li>
                <Icon name="phone" class="info-card__icon" />
                <div>
                  <span>Phone</span>
                  <a href="tel:+15555550199">(555) 555-0199</a>
                </div>
              </li>
              <li>
                <Icon name="mail" class="info-card__icon" />
                <div>
                  <span>Email</span>
                  <a href="mailto:hello@willgroomrestorations.com">hello@willgroomrestorations.com</a>
                </div>
              </li>
              <li>
                <Icon name="pin" class="info-card__icon" />
                <div>
                  <span>Service area</span>
                  Local region &amp; surrounding counties
                </div>
              </li>
              <li>
                <Icon name="clock" class="info-card__icon" />
                <div>
                  <span>Studio hours</span>
                  Tue – Sat, 9am – 5pm
                </div>
              </li>
            </ul>
          </div>

          <div class="map-placeholder" role="img" aria-label="Service area map placeholder">
            <Icon name="pin" class="map-placeholder__icon" />
            <span>Service area map embed</span>
          </div>
        </aside>
      </div>
    </section>

    <!-- Big CTA -->
    <section class="section section--plum contact-cta">
      <div class="container text-center">
        <p class="eyebrow">Begin the restoration</p>
        <h2>Let’s bring your piece back to life</h2>
        <p class="lead mx-auto">
          Every great restoration starts with a conversation. Choose the way
          you’d like to reach us.
        </p>
        <div class="big-ctas">
          <a href="#quote" class="btn btn--gold btn--lg">Get a Free Quote</a>
          <a href="tel:+15555550199" class="btn btn--ghost btn--lg">Call (555) 555-0199</a>
          <a href="mailto:hello@willgroomrestorations.com" class="btn btn--ghost btn--lg">Email Us</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    padding-block: clamp(4rem, 9vw, 7rem);
  }
  .page-hero h1 {
    max-width: 18ch;
  }
  .page-hero .lead {
    max-width: 56ch;
  }

  /* Layout */
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .contact-form-wrap h2 {
    margin-bottom: 0.3rem;
  }
  .contact-form-wrap__sub {
    color: var(--ink-soft);
    margin-bottom: 1.8rem;
  }

  /* Form */
  .contact-form {
    display: grid;
    gap: 1.1rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field label {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--plum);
    text-transform: uppercase;
  }
  .field__opt {
    text-transform: none;
    font-weight: 400;
    color: var(--ink-soft);
    letter-spacing: 0;
  }
  .field input,
  .field textarea {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.85rem 1rem;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
    width: 100%;
  }
  .field textarea {
    resize: vertical;
    min-height: 120px;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.18);
  }
  .form-status {
    margin: 0.2rem 0 0;
    min-height: 1.2em;
    font-size: 0.95rem;
    color: var(--plum-soft);
  }
  .form-status.is-success {
    color: #2f7d4f;
    font-weight: 600;
  }
  .form-note {
    margin-top: 1.2rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  /* Info card */
  .info-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.2rem);
    box-shadow: 0 24px 50px -34px var(--shadow);
  }
  .info-card h3 {
    color: var(--plum);
    margin-bottom: 1.2rem;
  }
  .info-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.2rem;
  }
  .info-card li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .info-card__icon {
    color: var(--gold);
    flex: none;
    width: 24px;
    height: 24px;
    margin-top: 2px;
  }
  .info-card li span {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: rgba(201, 162, 39, 0.85);
    margin-bottom: 0.15rem;
  }
  .info-card li a {
    color: var(--plum);
    font-weight: 600;
  }
  .info-card li a:hover {
    color: var(--plum-soft);
  }

  /* Map placeholder */
  .map-placeholder {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 200px;
    border: 1px dashed var(--line);
    border-radius: var(--radius-lg);
    background: repeating-linear-gradient(
      45deg,
      rgba(201, 162, 39, 0.05),
      rgba(201, 162, 39, 0.05) 12px,
      transparent 12px,
      transparent 24px
    );
    color: var(--ink-soft);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .map-placeholder__icon {
    width: 30px;
    height: 30px;
    color: var(--gold);
  }

  /* Big CTA */
  .contact-cta .lead {
    max-width: 56ch;
  }
  .big-ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  @media (max-width: 880px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  if (form && status) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      status.textContent =
        "Thank you — your message is on its way. We'll be in touch shortly.";
      status.classList.add("is-success");
      form.reset();
    });
  }
</script>
