---
interface Props {
  title?: string;
  text?: string;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
}
const {
  title = "Ready to restore your piece? Let’s talk.",
  text = "Every great restoration begins with a conversation. Tell us about your furniture and we’ll guide you through the possibilities.",
  primary = { href: "/contact", label: "Get a Free Quote" },
  secondary = { href: "/about", label: "View Our Work" },
} = Astro.props;
---

<section class="cta-band section--plum">
  <div class="container cta-band__inner reveal">
    <div class="cta-band__text">
      <p class="eyebrow">Begin the restoration</p>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cta-band__actions">
      <a href={primary.href} class="btn btn--gold">{primary.label}</a>
      {secondary && <a href={secondary.href} class="btn btn--ghost">{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    flex-wrap: wrap;
  }
  .cta-band__text {
    max-width: 60ch;
  }
  .cta-band__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  @media (max-width: 720px) {
    .cta-band__actions {
      width: 100%;
    }
    .cta-band__actions .btn {
      flex: 1;
    }
  }
</style>
