---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="Will Groom Restorations — home">
      <span class="brand__monogram" aria-hidden="true">WGR</span>
      <span class="brand__text">
        <span class="brand__name">Will Groom</span>
        <span class="brand__sub">Restorations</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      data-nav-toggle
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" data-nav id="primary-nav" aria-label="Primary">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={isActive(link.href) ? "is-active" : ""}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/contact" class="btn btn--gold nav-cta">Get a Free Quote</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(28, 16, 48, 0.72);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid rgba(201, 162, 39, 0.18);
    transition: background 0.4s var(--ease), box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }

  .site-header.is-scrolled {
    background: rgba(28, 16, 48, 0.95);
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.8);
    border-bottom-color: rgba(201, 162, 39, 0.35);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 74px;
  }

  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--cream);
  }

  .brand__monogram {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    color: var(--plum-deep);
    background: linear-gradient(135deg, var(--gold-light), var(--gold));
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(28, 16, 48, 0.25);
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .brand__name {
    font-family: var(--font-serif);
    font-size: 1.18rem;
    font-weight: 600;
    color: var(--cream);
  }

  .brand__sub {
    font-size: 0.7rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* Nav */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-nav ul {
    display: flex;
    gap: 1.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a:not(.btn) {
    position: relative;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(246, 241, 231, 0.85);
    padding: 0.4rem 0;
    transition: color 0.3s var(--ease);
  }

  .site-nav a:not(.btn)::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 2px;
    background: var(--gold);
    transition: width 0.35s var(--ease);
  }

  .site-nav a:not(.btn):hover,
  .site-nav a.is-active {
    color: var(--cream);
  }

  .site-nav a:not(.btn):hover::after,
  .site-nav a.is-active::after {
    width: 100%;
  }

  .nav-cta {
    padding: 0.6rem 1.3rem;
    font-size: 0.88rem;
  }

  /* Hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid rgba(201, 162, 39, 0.4);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    height: 2px;
    width: 22px;
    margin-inline: auto;
    background: var(--gold);
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 860px) {
    .nav-toggle {
      display: flex;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: rgba(28, 16, 48, 0.98);
      border-bottom: 1px solid rgba(201, 162, 39, 0.3);
      padding: 0.5rem 1.25rem 1.5rem;
      clip-path: inset(0 0 100% 0);
      opacity: 0;
      pointer-events: none;
      transition: clip-path 0.4s var(--ease), opacity 0.3s var(--ease);
    }

    .site-nav.is-open {
      clip-path: inset(0 0 0 0);
      opacity: 1;
      pointer-events: auto;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0;
    }

    .site-nav li {
      border-bottom: 1px solid rgba(201, 162, 39, 0.12);
    }

    .site-nav a:not(.btn) {
      display: block;
      padding: 0.95rem 0.25rem;
      font-size: 1.05rem;
    }

    .nav-cta {
      margin-top: 1rem;
      text-align: center;
      justify-content: center;
    }
  }
</style>
